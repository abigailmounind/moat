# 复制为 .env 后填写；.env 已被 Git 忽略，不要提交真实密钥。
# 所有模型必须在百炼新加坡控制台启用 Free Quota Only 后才能确认该开关。
ALIYUN_DASHSCOPE_API_KEY=
ALIYUN_MODEL_BASE_URL=https://your-workspace-id.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
ALIYUN_FREE_MODELS=qwen-flash
ALIYUN_FREE_ONLY_CONFIRMED=false
ALIYUN_MODEL_DAILY_CALL_LIMIT=100
MOAT_MODEL_CALLS_PER_HOUR=6
MOAT_MODEL_TIMEOUT_MS=75000

