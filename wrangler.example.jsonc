{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moat-api",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-12",
  "workers_dev": true,
  "vars": {
    "MOAT_PUBLIC_API_ENABLED": "true",
    "MOAT_MODEL_ENABLED": "false"
  },
  "ratelimits": [
    { "name": "API_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "SESSION_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moat-production",
      "database_id": "replace-with-cloudflare-d1-database-id",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "env": {
    "staging": {
      "name": "moat-api-staging",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "MOAT_PUBLIC_API_ENABLED": "true",
        "MOAT_MODEL_ENABLED": "false"
      },
      "ratelimits": [
        { "name": "API_RATE_LIMITER", "namespace_id": "1101", "simple": { "limit": 120, "period": 60 } },
        { "name": "SESSION_RATE_LIMITER", "namespace_id": "1102", "simple": { "limit": 10, "period": 60 } }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "moat-staging",
          "database_id": "replace-with-separate-staging-d1-database-id",
          "migrations_dir": "cloudflare/migrations"
        }
      ]
    }
  }
}
